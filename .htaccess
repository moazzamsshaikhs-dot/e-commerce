# ShopEase Pro - Root .htaccess
Options -Indexes

# PHP error logging
php_flag display_errors Off
php_flag log_errors On
php_value error_log "/home/u952571362/domains/shopeasepro.com/public_html/logs/php_errors.log"

# Security headers
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set X-XSS-Protection "1; mode=block"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

# Protect sensitive files
<FilesMatch "\.(sql|log|env|git|htpasswd|bak|config|ini|sh|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block access to debug/utility files in production
<FilesMatch "^(debug_|get_errors|fix_|path-check|phpinfo|test|install|setup)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Allow .htaccess itself
<Files ".htaccess">
    Order allow,deny
    Deny from all
</Files>

# Block access to hidden files and directories
RedirectMatch 404 /\..*$

# Block access to backup files
<FilesMatch "\.(bak|old|orig|temp)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevent access to includes directory
RewriteRule ^includes/.*$ - [F,L]

# Prevent access to vendor directory (except specific files)
RewriteRule ^vendor/.*\.(php|inc)$ - [F,L]

# Pretty URLs (optional - enable if needed)
# RewriteEngine On
# RewriteCond %{REQUEST_FILENAME} !-f
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]

# Maintenance mode redirect
RewriteEngine On
RewriteCond %{REMOTE_ADDR} !^127\.0\.0\.1$
RewriteCond %{REMOTE_ADDR} !^::1$
RewriteCond %{DOCUMENT_ROOT}/.maintenance -f
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|gif|ico|svg|woff|woff2|ttf|eot)$ [NC]
RewriteRule .* /maintenance.php [L]

# Enable Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml application/atom+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# Custom error pages
ErrorDocument 403 /error/403.html
ErrorDocument 404 /error/404.html
ErrorDocument 500 /error/500.html